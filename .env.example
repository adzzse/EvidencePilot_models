GENERATION_PROVIDER=remote
GENERATION_API_KEY=
# Optional OpenRouter-only failover: leave GENERATION_API_KEY empty and set 1-3 distinct keys.
# GENERATION_API_KEYS=["key-a","key-b","key-c"]
GENERATION_BASE_URL=https://openrouter.ai/api/v1
GENERATION_MODEL=
GENERATION_FALLBACK_MODELS=[]
GENERATION_EXTRA_BODY={}
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional legacy generation only: explicitly set GENERATION_PROVIDER=ollama to enable.
# OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
MODEL_API_KEY=change-me
MODEL_MAX_CONCURRENT_REQUESTS=4
MODEL_MIN_INTERVAL_MS=4000
EXTRACTION_ALLOWED_HOSTS=storage.example.com
MINERU_COMMAND=mineru
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=600
NGROK_AUTHTOKEN=
